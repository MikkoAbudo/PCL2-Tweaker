<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PCL2.TweakLoader</AssemblyName>
    <RootNamespace>PclTweaks</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Product>PCL2 Tweak Loader</Product>
    <Description>Optional, reversible tweaks for Plain Craft Launcher 2</Description>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>../lib/Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="../lib/Mono.Cecil.dll" LogicalName="PclTweaks.Mono.Cecil.dll" />
  </ItemGroup>
</Project>
